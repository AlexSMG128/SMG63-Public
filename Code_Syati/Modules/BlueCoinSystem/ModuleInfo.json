{
  "Name": "BlueCoinSystem",
  "Author": "Evanbowl and Lord-Giganticus",
  "Description": "Full Blue Coin System [63]",
  "CompilerFlags" : [
    "-DBLUECOINSYSTEM"
  ],
  "InstallDependancies": ["Syati_ObjectFactories", "Syati_Init", "PTUtils", "CoinBase"],
  "ModuleDependancies": ["PTUtils", "CoinBase_API", "Syati_ExtGameData_API"],
  "ModuleData" : [
    {
      "NameObjFactory": [
        {
          "Name" : "BlueCoin",
          "Function" : "BlueCoinUtil::createBlueCoin",
          "Include" : "BlueCoinUtil.h"
        }
      ],
      "StationedFileEntry" : [
        {
          "Type1" : "1",
          "Type2" : "6",
          "Path" : "/ObjectData/BlueCoin.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "6",
          "Path" : "/ObjectData/BlueCoinClear.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "7",
          "Path" : "/LayoutData/BlueCoinCounterInStage.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "7",
          "Path" : "/LayoutData/BlueCoinStageProgress.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "1",
          "Path" : "/SystemData/BlueCoinIDRangeTable.arc"
        }
      ],
      "CoinBaseSpawning": [
        {
          "ID" : "1",
          "CoinCreateFunc" : "BlueCoinUtil::tryCreateBlueCoinForSpawningActorActionKeeper",
          "CoinAppearFunc" : "BlueCoinUtil::tryAppearBlueCoinActionKeeper",
          "Include" : "BlueCoinUtil.h"
        }
      ],
      "GLE__IsGalaxyAllComplete": [
        {
          "Name": "BlueCoinAllCheck",
          "Function" : "BlueCoinUtil::checkStageBlueCoinCompletion",
          "Include": "BlueCoinUtil.h"
        }
      ],
      "GLE__onScenarioSelectAppear": [
        {
          "Name": "BCSScenarioSelectAppear",
          "Function" : "onGLEScenarioSelectInit",
          "Include" : "BlueCoinLayouts.h"
        }
      ],
      "GLE__exeAfterScenarioSelected": [
        {
          "Name": "BCSScenarioSelectAppear",
          "Function" : "onGLEScenarioSelectSelect",
          "Include" : "BlueCoinLayouts.h"
        }
      ],
      "GLE__onShowGalaxyInfoBanner": [
        {
          "Name": "BCSGalaxyBannerAppear",
          "Function" : "onGLEGalaxyInfoAppear",
          "Include" : "BlueCoinLayouts.h"
        }
      ],
      "NewSaveChunk": [
        {
          "ChunkMemberType": "BlueCoinDataStorage",
          "ChunkMemberName": "mBlueCoinDataStorage",
          "ChunkCreationFunc": "createBinaryChunk<BlueCoinDataStorage>",
          "Include": "BlueCoinDataStorage.h"
        }
      ]
    }
  ]
}